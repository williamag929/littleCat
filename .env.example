# Little Cat Pet Game - Environment Configuration
# Copy this file to .env and fill in your values
# .env is git-ignored (secrets stay private)

# ===== OPENAI API (Required for LARY Chat Agent) =====
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ===== Optional: Custom Chat Settings =====
# Uncomment to override config.py settings

# CHAT_MAX_TOKENS=300
# CHAT_MODEL=gpt-3.5-turbo
# CHAT_HISTORY_LENGTH=15
# CHAT_API_TIMEOUT=10.0

# ===== Cost Control =====
# Monitor your OpenAI usage at: https://platform.openai.com/account/usage/overview
# gpt-4-vision: ~$0.03 per image request
# Set CHAT_ENABLED=False in config.py to disable if needed
